#include <iostream>
#include <map>

using namespace std;

int calc(map<string, int>& category_num){
    int result=1;
    
    for( auto p : category_num){
        result *= (p.second + 1); // 없음 추가
    }
    
    return result-1;
}

int main()
{
    int n;
    cin >> n;
    
    while(n--){
        int m;
        cin >> m;
        
        map<string, int> category_num;
        
        for(int i=0; i<m; i++){
            string name, category;
            cin >> name >> category;
            
             category_num[category]++;
        }
    
    cout << calc(category_num) << '\n';
    }
    


    return 0;
}