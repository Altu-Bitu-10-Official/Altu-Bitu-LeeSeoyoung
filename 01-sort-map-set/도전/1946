#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int solve(vector<pair<int, int>> applicants){
    sort(applicants.begin(), applicants.end());
    
    int count = 1; // 첫번째 지원자는 합격 
    int interview = applicants[0].second;
    
    for(int i=1; i<applicants.size(); i++){
        if(interview > applicants[i].second){
            count++;
            interview = applicants[i].second;
        }
    }
    
    return count;
}


int main()
{
    int T;
    cin >> T;
    
    for(int i=0; i< T; i++){
        int N;
        cin >> N;
        
        vector<pair<int, int>> applicants(N);
        
        for(int i=0; i<N; i++){
            cin >> applicants[i].first >> applicants[i].second;
            
        }
        
        cout << solve(applicants) << '\n';
        
    }

    return 0;
}