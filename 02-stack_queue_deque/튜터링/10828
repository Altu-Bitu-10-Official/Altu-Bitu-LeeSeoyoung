#include <iostream>
#include <vector>

using namespace std;

int main()
{
    int n, x; 
    cin >> n;
    
    string cmd;
    
    vector<int> v(100000);
    int top = -1;
    
    while(n--){
        
        cin >> cmd;
        
        if(cmd == "push"){
            cin >> x;
            top++;
            v[top] = x;
        } 
        else if(cmd == "pop"){
            if(top == -1){
                cout << -1 << "\n";
            } else{
                cout << v[top] << "\n";
                top--;
            }
        }
        else if(cmd == "size"){
            cout << top+1 << "\n";
        }
        else if(cmd == "empty"){
            if(top == -1){
                cout << 1 << "\n";
            }else{ cout << 0 << "\n";}
        }
        else if(cmd == "top"){
            if(top == -1){
                cout << -1 << "\n";
            } else {
                cout << v[top] << "\n";
            }
        }
    }

    return 0;
}