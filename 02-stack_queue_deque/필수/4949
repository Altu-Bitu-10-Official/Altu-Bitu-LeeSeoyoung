#include <iostream>
#include <stack>

using namespace std;

int main()
{
    while(true){
        string s;
        getline(cin, s);
        if(s == ".") break;
        
        stack<char> st;
        
        bool isValid = true;
        
        for(int i=0; i<s.length(); i++){
            if(s[i] == '(' || s[i] == '['){
                st.push(s[i]);
            }
            else if(s[i] == ')'){
                if(st.top() != '(' || st.empty()){
                    isValid = false;
                    break;
                }
                st.pop();
            }
            else if(s[i] == ']'){
                if(st.top() != '[' || st.empty()){
                    isValid = false;
                    break;
                }
                st.pop();
            }
        }
        
        if(isValid && st.empty()){
                cout << "yes\n";
        } else{
                cout << "no\n";
        }
    }


    return 0;
}