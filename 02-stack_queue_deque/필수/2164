#include <iostream>
#include <queue>

using namespace std;

int main()
{
    int n, x;
    cin >> n;
    
    queue<int> q;
    
    for(int i=1; i<=n; i++){
        q.push(i);
    }
    
    while(!q.empty()){
        
        if(q.size() == 1){
            cout << q.front();
            break;
        } else {
            q.pop();
            x = q.front();
            q.push(x);
            q.pop();
        }
    }

    return 0;
}